APP_ENV=development

# Base fallback values. .env.<APP_ENV> overrides these at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qsets_dev
BIND_ADDR=0.0.0.0:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
COOKIE_SECURE=false
# Defaults to the number of logical CPUs. Lower this if generation competes with other work.
GENERATION_CONCURRENCY=2
# Only enable behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Defaults to ./static relative to the working directory.
# STATIC_DIR=/srv/qsets-server/static
# Audit entries older than this many days are deleted hourly; 0 keeps them forever.
AUDIT_RETENTION_DAYS=365

# Origin used in emailed links (verification, password reset). Required outside development.
# PUBLIC_BASE_URL=https://qsets.example.com
# Set to false to stop anyone but admins from creating accounts.
ALLOW_REGISTRATION=true
# Outgoing email. Without SMTP_HOST, emails are only written to the server log (development).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls   # starttls (default), tls (implicit TLS, usually port 465) or none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="QSets <no-reply@example.com>"
