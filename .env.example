APP_ENV=development

# Base fallback values. .env.<APP_ENV> overrides these at runtime.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/qsets_dev
BIND_ADDR=0.0.0.0:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
COOKIE_SECURE=false
# Defaults to the number of logical CPUs. Lower this if generation competes with other work.
GENERATION_CONCURRENCY=2
# Only enable behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Defaults to ./static relative to the working directory.
# STATIC_DIR=/srv/qsets-server/static
